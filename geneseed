#!/usr/bin/env bash
#
# Geneseed — front door. A thin shim: it finds the checkout and hands every argument
# to the Node CLI, which owns the verbs, the parsing and the refusals.
#
#     ./geneseed                    open the web console, else the TUI menu (`home`)
#     ./geneseed <command> [args]   anything bin/geneseed-cli.mjs carries
#     ./geneseed --help             the verb list, printed by the CLI itself
#
# NO VERB TABLE HERE, deliberately. This launcher used to enumerate the commands it
# would forward, and that list had gone stale: `migrate`, `exclude` and `rule-gate`
# all existed, all fell to its `*)` arm and all exited 2 — while `geneseed.cmd`
# passed everything through, so the two front doors disagreed about what the harness
# could do. One CLI, one verb table, one refusal. `./geneseed` in a checkout now
# behaves exactly like the `geneseed` an `npm i -g` puts on PATH, because that is
# this same entry point (package.json `bin`). The four HOOK verbs (`context`,
# `learn`, `git-gate`, `rule-gate`) live on `bin/geneseed-hook.mjs` and are reached
# by hooks with a baked absolute path; the CLI's refusal names that file.
#
# $GENESEED_NODE overrides the interpreter — the analogue of the $PYTHON knob this
# file carried while the harness was Python. Unset, a bare `node` is used.
set -eo pipefail
# Resolve through symlinks so HERE is the real repo dir. `geneseed link` writes a
# shim naming its entry by absolute path rather than a symlink, but an install made
# before it did left ~/.local/bin/geneseed pointing at THIS file, and this loop is
# the only reason those still work.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$dir/$SOURCE" ;; esac
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Bare `./geneseed` is the `home` verb — the web console when the environment can
# show it (interactive + GUI browser), else the interactive TUI menu; GENESEED_NO_WEB=1
# disables the web-first default. The CLI entry requires a verb, so the default is here.
if [ "$#" -eq 0 ]; then set -- home; fi
exec "${GENESEED_NODE:-node}" "$HERE/bin/geneseed-cli.mjs" "$@"
