{
  "name": "feature",
  "description": "Plan the feature into ordered iterations, then build each one test-first: a failing test, apply, test, and review, until the plan is complete — and an independent done-check maps every requirement to a passing test before the loop closes.",
  "category": "development",
  "nodes": ["plan", "identify", "red-test", "apply", "test", "review", "done-check"],
  "start": "plan",
  "edges": [
    { "from": "plan", "on": "pass", "to": "identify" },
    { "from": "identify", "on": "more", "to": "red-test" },
    { "from": "identify", "on": "done", "to": "done-check" },
    { "from": "red-test", "on": "red", "to": "apply" },
    { "from": "red-test", "on": "green", "to": "test" },
    { "from": "red-test", "on": "untestable", "to": "$stop" },
    { "from": "apply", "on": "pass", "to": "test" },
    { "from": "test", "on": "pass", "to": "review" },
    { "from": "test", "on": "fail", "to": "apply" },
    { "from": "review", "on": "pass", "to": "identify" },
    { "from": "review", "on": "fail", "to": "apply" },
    { "from": "done-check", "on": "pass", "to": "$close" },
    { "from": "done-check", "on": "fail", "to": "identify" }
  ],
  "loops": [
    { "name": "iterations", "nodes": ["identify", "red-test", "apply", "test", "review", "done-check"], "max": 20, "iteration": true },
    { "name": "apply-test", "nodes": ["apply", "test"], "max": 2 },
    { "name": "review-fix", "nodes": ["apply", "test", "review"], "max": 3 }
  ]
}
