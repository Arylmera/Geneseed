{
  "name": "ci-repair",
  "description": "Read the branch's failing CI checks, fix one code failure per iteration, test, and push, until CI is green or only flaky or infra failures remain.",
  "category": "day-to-day",
  "nodes": ["ci-triage", "ci-fix", "test"],
  "start": "ci-triage",
  "edges": [
    { "from": "ci-triage", "on": "more", "to": "ci-fix" },
    { "from": "ci-triage", "on": "done", "to": "$close" },
    { "from": "ci-fix", "on": "pass", "to": "test" },
    { "from": "ci-fix", "on": "fail", "to": "$stop" },
    { "from": "test", "on": "pass", "to": "ci-triage" },
    { "from": "test", "on": "fail", "to": "ci-fix" }
  ],
  "loops": [
    { "name": "iterations", "nodes": ["ci-triage", "ci-fix", "test"], "max": 10, "iteration": true },
    { "name": "fix-test", "nodes": ["ci-fix", "test"], "max": 1 }
  ]
}
