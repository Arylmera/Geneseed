{
  "name": "update-contract",
  "description": "Change an interface with live consumers — an API, a schema, an event — as expand, migrate one consumer per iteration, contract: plan it for the user to review, then apply, test, check old and new consumers, and review.",
  "category": "architecture",
  "rules": [
    "Contract files (OpenAPI, AsyncAPI, protobuf, Avro, GraphQL schemas, Flyway and Liquibase migrations) stop for a human by default; a stop on one is expected, not a failure.",
    "`geneseed loop init --contracts <globs>` appends more contract globs, and LOOP.md's `contracts` can be trimmed."
  ],
  "nodes": ["migration-plan", "identify", "apply", "test", "compat-check", "review"],
  "start": "migration-plan",
  "edges": [
    { "from": "migration-plan", "on": "pass", "to": "identify" },
    { "from": "migration-plan", "on": "fail", "to": "$stop" },
    { "from": "identify", "on": "more", "to": "apply" },
    { "from": "identify", "on": "done", "to": "$close" },
    { "from": "apply", "on": "pass", "to": "test" },
    { "from": "test", "on": "pass", "to": "compat-check" },
    { "from": "test", "on": "fail", "to": "apply" },
    { "from": "compat-check", "on": "pass", "to": "review" },
    { "from": "compat-check", "on": "fail", "to": "apply" },
    { "from": "review", "on": "pass", "to": "identify" },
    { "from": "review", "on": "fail", "to": "apply" }
  ],
  "loops": [
    { "name": "iterations", "nodes": ["identify", "apply", "test", "compat-check", "review"], "max": 20, "iteration": true },
    { "name": "apply-test", "nodes": ["apply", "test"], "max": 1 },
    { "name": "review-fix", "nodes": ["apply", "test", "compat-check", "review"], "max": 3 }
  ],
  "contracts": [
    "**/openapi*.yaml", "**/openapi*.yml", "**/openapi*.json", "**/asyncapi*.yaml", "**/*.proto", "**/*.avsc",
    "**/*.graphqls", "**/*.graphql", "**/asyncapi*.yml", "**/asyncapi*.json", "**/db/migration/**", "**/db/changelog/**"
  ]
}
