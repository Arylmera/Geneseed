{
  "name": "issue-to-pr",
  "description": "Take one issue, let triage pick the loop that fits (bugfix, feature, deps-upgrade or refactor), open the pull request and wait for green CI; red CI sends the work back to that loop, twice at most. The merge stays yours.",
  "category": "development",
  "rules": [
    "Never merge, and never enable auto-merge: the run ends at an open PR with green CI.",
    "Push only this worktree's own branch."
  ],
  "stages": ["intake", "triage", "loop:$triaged", "pr-open", "merge-gate", "retro"],
  "start": "intake",
  "loops": ["bugfix", "feature", "deps-upgrade", "refactor"],
  "edges": [
    { "from": "intake", "on": "pass", "to": "triage" },
    { "from": "intake", "on": "fail", "to": "$stop" },
    { "from": "triage", "on": "pass", "to": "loop:$triaged" },
    { "from": "triage", "on": "fail", "to": "$stop" },
    { "from": "loop:$triaged", "on": "pass", "to": "pr-open" },
    { "from": "loop:$triaged", "on": "fail", "to": "$stop" },
    { "from": "pr-open", "on": "pass", "to": "merge-gate" },
    { "from": "pr-open", "on": "fail", "to": "$stop" },
    { "from": "merge-gate", "on": "pass", "to": "retro" },
    { "from": "merge-gate", "on": "fail", "to": "loop:$triaged" },
    { "from": "merge-gate", "on": "none", "to": "retro" },
    { "from": "retro", "on": "pass", "to": "$close" }
  ],
  "cycles": [{ "name": "ci", "nodes": ["loop:$triaged", "pr-open", "merge-gate"], "max": 2 }]
}
