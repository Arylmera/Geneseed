{
  "name": "issue-to-pr",
  "description": "Take one issue, let triage pick the lane that fits (the bugfix, feature, deps-upgrade or refactor loop, or a docs-only update), run the base branch's checks and a review panel, play the holdout scenarios it never saw, open the pull request and wait for green CI; a failed check, review or scenario, or red CI, sends the work back to that lane, twice at most each. At the end it asks you once whether to merge.",
  "category": "development",
  "rules": [
    "Never merge or enable auto-merge without the user's yes, asked once at the end of the run.",
    "Push only this worktree's own branch."
  ],
  "stages": [
    "intake", "holdout-write", "triage",
    "loop:bugfix", "loop:feature", "loop:deps-upgrade", "loop:refactor", "docs-update",
    "checks", "review-panel", "holdout", "pr-open", "merge-gate", "retro"
  ],
  "start": "intake",
  "edges": [
    { "from": "intake", "on": "pass", "to": "holdout-write" },
    { "from": "intake", "on": "fail", "to": "$stop" },
    { "from": "intake", "on": "needs-info", "to": "holdout-write" },
    { "from": "intake", "on": "reject", "to": "$stop" },
    { "from": "holdout-write", "on": "pass", "to": "triage" },
    { "from": "holdout-write", "on": "fail", "to": "$stop" },
    { "from": "triage", "on": "bug", "to": "loop:bugfix" },
    { "from": "triage", "on": "feature", "to": "loop:feature" },
    { "from": "triage", "on": "deps", "to": "loop:deps-upgrade" },
    { "from": "triage", "on": "refactor", "to": "loop:refactor" },
    { "from": "triage", "on": "docs", "to": "docs-update" },
    { "from": "triage", "on": "fail", "to": "$stop" },
    { "from": "loop:bugfix", "on": "pass", "to": "checks" },
    { "from": "loop:bugfix", "on": "fail", "to": "$stop" },
    { "from": "loop:feature", "on": "pass", "to": "checks" },
    { "from": "loop:feature", "on": "fail", "to": "$stop" },
    { "from": "loop:deps-upgrade", "on": "pass", "to": "checks" },
    { "from": "loop:deps-upgrade", "on": "fail", "to": "$stop" },
    { "from": "loop:refactor", "on": "pass", "to": "checks" },
    { "from": "loop:refactor", "on": "fail", "to": "$stop" },
    { "from": "docs-update", "on": "pass", "to": "checks" },
    { "from": "checks", "on": "pass", "to": "review-panel" },
    { "from": "checks", "on": "fail", "to": "$lane" },
    { "from": "checks", "on": "error", "to": "review-panel" },
    { "from": "checks", "on": "none", "to": "checks" },
    { "from": "review-panel", "on": "pass", "to": "holdout" },
    { "from": "review-panel", "on": "fail", "to": "$lane" },
    { "from": "holdout", "on": "pass", "to": "pr-open" },
    { "from": "holdout", "on": "fail", "to": "$lane" },
    { "from": "holdout", "on": "error", "to": "$stop" },
    { "from": "pr-open", "on": "pass", "to": "merge-gate" },
    { "from": "pr-open", "on": "fail", "to": "$stop" },
    { "from": "merge-gate", "on": "pass", "to": "retro" },
    { "from": "merge-gate", "on": "fail", "to": "$lane" },
    { "from": "merge-gate", "on": "none", "to": "retro" },
    { "from": "retro", "on": "pass", "to": "$close" }
  ],
  "cycles": [
    { "name": "done-list", "nodes": ["checks"], "max": 1 },
    { "name": "checks", "nodes": ["$lane", "checks"], "max": 2 },
    { "name": "review", "nodes": ["$lane", "checks", "review-panel"], "max": 2 },
    { "name": "holdout", "nodes": ["$lane", "checks", "review-panel", "holdout"], "max": 2 },
    { "name": "ci", "nodes": ["$lane", "checks", "review-panel", "holdout", "pr-open", "merge-gate"], "max": 2 }
  ],
  "review": {
    "seats": {
      "small": ["reviewer"],
      "medium": ["reviewer", "tester"],
      "large": ["reviewer", "tester", "steward"],
      "areas": { "security": ["security"], "performance": ["performance"], "ui": ["user-advocate"], "data": ["security"] }
    }
  }
}
