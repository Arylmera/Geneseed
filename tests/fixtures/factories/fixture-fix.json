{
  "name": "fixture-fix",
  "description": "Test fixture: plan, run the bugfix loop, review; a failed review sends the item back to the loop.",
  "rules": ["Never merge."],
  "stages": ["plan", "loop:bugfix", "review"],
  "start": "plan",
  "edges": [
    { "from": "plan", "on": "pass", "to": "loop:bugfix" },
    { "from": "loop:bugfix", "on": "pass", "to": "review" },
    { "from": "loop:bugfix", "on": "fail", "to": "$stop" },
    { "from": "review", "on": "pass", "to": "$close" },
    { "from": "review", "on": "fail", "to": "loop:bugfix" }
  ],
  "cycles": [{ "name": "rework", "nodes": ["loop:bugfix", "review"], "max": 2 }]
}