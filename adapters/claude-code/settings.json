{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node bin/geneseed-hook.mjs git-gate" }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node bin/geneseed-hook.mjs rule-gate" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "command": "node -e \"process.stdout.write(require('fs').readFileSync('AGENT.md','utf8'))\"" },
          { "type": "command", "command": "node bin/geneseed-hook.mjs context" }
        ]
      },
      {
        "matcher": "resume|compact|fork",
        "hooks": [
          { "type": "command", "command": "node bin/geneseed-hook.mjs context" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node bin/geneseed-hook.mjs learn || exit 0" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node bin/geneseed-hook.mjs learn || exit 0" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node bin/geneseed-hook.mjs learn || exit 0" }
        ]
      }
    ]
  }
}
